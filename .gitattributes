# =========================
# Default
# =========================

* text=auto

# =========================
# Source code
# =========================

*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.cc    text eol=lf
*.cxx   text eol=lf
*.hpp   text eol=lf
*.hh    text eol=lf
*.hxx   text eol=lf

# =========================
# Build / scripts
# =========================

*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.py    text eol=lf

# =========================
# Documentation
# =========================

*.md    text eol=lf
*.txt   text eol=lf
*.rst   text eol=lf

# =========================
# Configuration
# =========================

*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.xml   text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf

# =========================
# GitHub
# =========================

.github/ text eol=lf


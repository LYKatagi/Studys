# ============================================================

# Git Attributes - Studys

# ============================================================

# ------------------------------------------------------------

# Text files

# ------------------------------------------------------------

* text=auto

# Markdown

*.md text eol=lf

# Source code

*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell / configuration

*.sh text eol=lf
*.bash text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf

# Windows scripts

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ------------------------------------------------------------

# Git / config files

# ------------------------------------------------------------

.gitattributes text eol=lf
.gitignore text eol=lf

# VS Code

.vscode/*.json text eol=lf

# ------------------------------------------------------------

# Binary files

# ------------------------------------------------------------

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

*.pdf binary
*.zip binary
*.7z binary
*.rar binary

*.exe binary
*.dll binary
*.so binary

# Fonts

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# ------------------------------------------------------------

# Generated / temporary files

# ------------------------------------------------------------

*.pyc binary
*.pyo binary

# Python cache

**pycache**/* -text

# Virtual environments

.venv/* -text

# Node

node_modules/* -text

# Build output

build/* -text
dist/* -text
out/* -text
bin/* -text
obj/* -text
